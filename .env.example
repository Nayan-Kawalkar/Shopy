# Copy to .env.local and fill in. Values come from Supabase dashboard > Project Settings > API.
# EXPO_PUBLIC_* values are bundled into the app, so only use the publishable (or anon) key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
google_client_id=1033245891785-lounq1617nodeh2541gmm60soe7k4jsn.apps.googleusercontent.com

# Optional: Google Maps key for the web map embed (Maps Embed API). Empty = OpenStreetMap on web.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: NewsAPI key for "Latest farm news" on the Articles tab. Empty = section hidden.
EXPO_PUBLIC_NEWS_API_KEY=

# Optional: data.gov.in key for live mandi prices (Articles tab). Empty = sample prices.
EXPO_PUBLIC_DATA_GOV_API_KEY=
